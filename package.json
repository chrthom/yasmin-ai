{
  "name": "yasmin-ai",
  "version": "0.1.0",
  "description": "An AI assistent API for thomsen.in",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "npx nodemon --watch src --ext ts --exec \"npm run build && npm run start\"",
    "s": "npm run dev",
    "test": "npx jest",
    "lint": "npx eslint src/*",
    "format": "npx prettier . --write",
    "check": "npm run format; npm run lint",
    "manage-context": "npx ts-node scripts/manage-context.ts",
    "nightly": "node dist/nightly/run.js",
    "nightly:dry-run": "node dist/nightly/run.js --dry-run",
    "bootstrap-memory": "npx ts-node scripts/bootstrap-memory.ts"
  },
  "private": true,
  "author": "Christopher Thomsen",
  "dependencies": {
    "cors": "^2.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "mysql2": "^3.22.5",
    "nodemon": "^3.0.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prefer-arrow": "~1.2.0",
    "jest": "^29.0.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tslib": "^2.0.0",
    "typescript": "~5.7.0"
  },
  "overrides": {
    "glob": "^10.0.0"
  }
}
