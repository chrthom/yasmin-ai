// Description for Mistral Console: Updates the content of an existing context memory entry. Use it when facts change, you learn new information, or feelings shift. Always read the existing entry first to check its content. You cannot create new entries or change titles — only update existing content.
{
  "type": "object",
  "required": ["title", "content"],
  "properties": {
    "title": {
      "type": "string",
      "description": "The exact title of the existing entry to update (e.g., \"Profile of Christopher\", \"Journal with Zara\")."
    },
    "content": {
      "type": "string",
      "description": "The new full content to replace the existing entry."
    }
  }
}
